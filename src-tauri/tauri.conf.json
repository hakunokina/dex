{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dex",
  "version": "0.2.0",
  "identifier": "com.hakunokina.dex",
  "build": {
    "beforeDevCommand": "cargo build -p dexd && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dex",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 640,
        "maximized": true,
        "theme": "Dark",
        "decorations": false,
        "backgroundColor": "#0e0f11"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "hakunokina",
    "windows": {
      "wix": { "upgradeCode": "db5b1b64-92a1-56cd-bb39-9d6086178561" },
      "nsis": { "installerHooks": "windows/identity-installer.nsh" }
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
