             SEND_MULTIPLE MVP dışı. Simge uygulamanınki. -->
        <activity-alias
            android:name=".ShareRepo"
            android:targetActivity=".MainActivity"
            android:label="Dex · Repo incele"
            android:exported="true">
            <intent-filter>
