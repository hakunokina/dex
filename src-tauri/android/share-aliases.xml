        <!-- dex-share-aliases:begin — build-apk.sh bu bloğu her derlemede silip yeniden ekler. -->
        <!-- #1759 şeffaf paylaşım: üç giriş WebView'sız ShareActivity tramplenine gider (hedef
             ShareActivity; alias adı görevi seçer: ShareRepo → repo, ShareVerify → verify,
             ShareAsk → ask; görev `dex.task` ile MainActivity'ye taşınır). Tramplen şeffaf temalı,
             iz bırakmaz (noHistory, son kullanılanlarda yok). Metin/bağlantı ve tek görsel;
             SEND_MULTIPLE MVP dışı. Simge uygulamanınki. -->
        <activity
            android:name=".ShareActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <activity-alias
            android:name=".ShareRepo"
            android:targetActivity=".ShareActivity"
            android:label="Dex · Repo incele"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ShareVerify"
            android:targetActivity=".ShareActivity"
            android:label="Dex · Kaynak doğrula"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ShareAsk"
            android:targetActivity=".ShareActivity"
            android:label="Dex · Asistana sor"
